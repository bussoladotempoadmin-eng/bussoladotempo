// ============================================================
// Bússola do Tempo — Schema do banco de dados
// Etapa 2 do roadmap (16-roadmap-construcao.md)
// Spec técnica: 14-spec-tecnica-app.md §6
// ============================================================

generator client {
  provider        = "prisma-client-js"
  // engineType "client" = sem engine nativo (.so.node): as queries são
  // compiladas em WASM e o driver `pg` faz a conexão. Elimina o binário que
  // não era empacotado no runtime serverless da Vercel.
  engineType      = "client"
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum SemanaInicio {
  DOMINGO
  SEGUNDA
}

enum DiaSemana {
  SEG
  TER
  QUA
  QUI
  SEX
  SAB
  DOM
}

enum Categoria {
  IMPORTANTE
  URGENTE
  DISPERSO
}

enum StatusSemana {
  PLANEJANDO  // em planejamento (antes de começar)
  ATIVA       // semana corrente
  REVISAO     // domingo, em revisão
  FECHADA     // arquivada
}

enum FonteOrigem {
  MANUAL
  AGENDA_PADRAO    // gerado pelo AgendaSuggester
  CALENDAR_IMPORT  // V2: importado do Google Calendar
}

enum TipoInsight {
  GOOD
  WARN
  TIP
  NEUTRAL
}

// ============================================================
// AUTENTICAÇÃO (NextAuth)
// ============================================================

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  emailVerified DateTime?
  image         String?
  senhaHash     String? // login por e-mail/senha (null = só Google/link mágico)
  superAdmin    Boolean       @default(false) // acesso ao painel de gestão do produto
  onboardingVisto Boolean     @default(false) // já viu o tour guiado inicial
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  accounts      Account[]
  sessions      Session[]
  workspaces    Workspace[]
  orgsCriadas   Organizacao[]  @relation("OrgOwner")
  equipes       MembroEquipe[]
  sugestoesEnviadas  Sugestao[] @relation("SugDe")
  sugestoesRecebidas Sugestao[] @relation("SugPara")
  pushSubscriptions  PushSubscription[]
  unidadesCoord      Unidade[]  @relation("UnidadeCoord")
  resetTokens        PasswordResetToken[]
  assinatura         Assinatura?         @relation("AssinaturaDono")
  parceiro           Parceiro?
}

// Token de "esqueci a senha" — uso único, com validade curta.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Inscrição Web Push (um device/navegador por linha). Lembretes do ritual semanal.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// DOMÍNIO — Workspace e Frentes
// ============================================================

model Workspace {
  id            String       @id @default(cuid())
  userId        String
  nome          String       @default("Meu workspace")
  timezone      String       @default("America/Sao_Paulo")
  semanaInicio  SemanaInicio @default(DOMINGO)
  horaAcordar   String       @default("06:00")
  horaDormir    String       @default("22:30")
  horaAlmocoIni String       @default("12:00")
  horaAlmocoFim String       @default("13:30")
  // Cota de IA: gerações extras compradas (além das 6/mês grátis). Billing-ready.
  geracoesExtras Int         @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  frentes      Frente[]
  compromissos CompromissoFixo[]
  semanas      SemanaPlano[]
  fechamentos  FechamentoDia[]
  geracoesIA   GeracaoIA[]

  @@index([userId])
}

// Registro de cada geração de IA (1 chamada = 1 linha). Aplicar em 2/4 semanas
// continua sendo 1 geração. Reabrir resultado salvo NÃO conta.
// Trava: 1 por semana ISO; teto: 6 por mês (+ geracoesExtras compradas).
model GeracaoIA {
  id               String   @id @default(cuid())
  workspaceId      String
  isoWeek          String // semana ISO em que gerou (trava semanal)
  mesRef           String // "YYYY-MM" (cota mensal)
  semanasAplicadas Int      @default(1)
  criadoEm         DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, mesRef])
  @@index([workspaceId, isoWeek])
}

model Frente {
  id             String   @id @default(cuid())
  workspaceId    String
  nome           String
  icone          String   @default("📌")
  cor            String   @default("#3b82f6")
  orcamentoHoras Float    @default(0)
  ordem          Int      @default(0)
  ativa          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  blocos       Bloco[]
  compromissos CompromissoFixo[]

  @@index([workspaceId])
}

model FechamentoDia {
  id          String   @id @default(cuid())
  workspaceId String
  data        String   // "YYYY-MM-DD" (dia local do usuário)
  destaque    String?  @db.Text // o que foi bom hoje
  aprendizado String?  @db.Text // o que dá pra melhorar amanhã
  nota        Int? // 1-5
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, data])
  @@index([workspaceId])
}

model CompromissoFixo {
  id          String    @id @default(cuid())
  workspaceId String
  diaSemana   DiaSemana
  horaInicio  String    // "HH:mm"
  horaFim     String    // "HH:mm"
  descricao   String
  frenteId    String?
  categoria   Categoria @default(IMPORTANTE)
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  frente    Frente?   @relation(fields: [frenteId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

// ============================================================
// DOMÍNIO — Semana, Blocos, Revisão, Insights
// ============================================================

model SemanaPlano {
  id           String       @id @default(cuid())
  workspaceId  String
  semanaIso    String       // ex: "2026-W24"
  status       StatusSemana @default(PLANEJANDO)
  prioridade1  String?      // ID do bloco prioritário
  prioridade2  String?
  prioridade3  String?
  riscoSemana  String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  blocos    Bloco[]
  revisao   Revisao?
  insights  Insight[]

  @@unique([workspaceId, semanaIso])
  @@index([workspaceId])
}

model Bloco {
  id                 String      @id @default(cuid())
  semanaPlanoId      String
  frenteId           String
  diaSemana          DiaSemana
  horaInicio         String      // "HH:mm"
  horaFim            String      // "HH:mm"
  tarefa             String      @db.Text
  categoriaPlanejada Categoria
  categoriaRealizada Categoria
  motivoDesvio       String?     @db.Text
  concluido          Boolean     @default(false) // demanda marcada como concluída
  concluidoEm        DateTime?   // quando foi concluída (data/hora real)
  prioridadeSemana   Int?        // 1, 2 ou 3
  invadido           Boolean     @default(false)
  fonteOrigem        FonteOrigem @default(MANUAL)
  externalEventId    String?     // id do Google Calendar (V2)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  semanaPlano SemanaPlano @relation(fields: [semanaPlanoId], references: [id], onDelete: Cascade)
  frente      Frente      @relation(fields: [frenteId], references: [id])
  subtarefas  SubTarefa[]

  @@index([semanaPlanoId])
  @@index([frenteId])
}

model SubTarefa {
  id        String   @id @default(cuid())
  blocoId   String
  texto     String   @db.Text
  hora      String? // "HH:mm" opcional — quando a tarefa tem horário marcado
  feito     Boolean  @default(false)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())

  bloco Bloco @relation(fields: [blocoId], references: [id], onDelete: Cascade)

  @@index([blocoId])
}

model Revisao {
  id                String    @id @default(cuid())
  semanaPlanoId     String    @unique
  retroFuncionou    String?   @db.Text
  retroNaoFuncionou String?   @db.Text
  retroMudanca      String?   @db.Text
  sensacaoMedia     Int?      // 1-5
  fechadaEm         DateTime?
  createdAt         DateTime  @default(now())

  semanaPlano SemanaPlano @relation(fields: [semanaPlanoId], references: [id], onDelete: Cascade)
}

model Insight {
  id            String      @id @default(cuid())
  semanaPlanoId String
  tipo          TipoInsight
  titulo        String
  texto         String      @db.Text
  frenteId      String?     // opcional, quando insight é sobre uma frente
  geradoEm      DateTime    @default(now())

  semanaPlano SemanaPlano @relation(fields: [semanaPlanoId], references: [id], onDelete: Cascade)

  @@index([semanaPlanoId])
}

// ============================================================
// EQUIPE — Organização e membros (Fase 4, módulo de time)
// Aditivo: não altera nada do individual. O gestor enxerga o tempo
// dos membros via Organizacao → MembroEquipe → User → Workspace.
// ============================================================

enum PapelEquipe {
  GESTOR // diretor/dono do time — vê os dados do time
  MEMBRO // líder/funcionário — dono da própria agenda
}

model Organizacao {
  id        String   @id @default(cuid())
  nome      String
  ownerId   String
  // Módulo Comercial (pago/ligável). false = só Bússola do Tempo.
  comercialAtivo Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User               @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  membros    MembroEquipe[]
  unidades   Unidade[]
  tiposAcao  TipoAcaoComercial[]
  assinatura Assinatura?

  @@index([ownerId])
}

enum StatusSugestao {
  PENDENTE
  ACEITA
  DISPENSADA
}

// Coach: o gestor sugere algo a um membro; o membro vê e aceita/dispensa.
// NÃO altera a agenda do membro (coach, não comando).
model Sugestao {
  id         String         @id @default(cuid())
  deUserId   String // gestor que sugeriu
  paraUserId String // membro que recebe
  texto      String         @db.Text
  status     StatusSugestao @default(PENDENTE)
  createdAt  DateTime       @default(now())

  de   User @relation("SugDe", fields: [deUserId], references: [id], onDelete: Cascade)
  para User @relation("SugPara", fields: [paraUserId], references: [id], onDelete: Cascade)

  @@index([paraUserId])
  @@index([deUserId])
}

model MembroEquipe {
  id            String      @id @default(cuid())
  organizacaoId String
  userId        String
  papel         PapelEquipe @default(MEMBRO)
  // Hierarquia: a quem este membro reporta (outro MembroEquipe).
  // null = reporta direto ao dono (diretor) da organização.
  chefeId       String?
  createdAt     DateTime    @default(now())

  organizacao  Organizacao    @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chefe        MembroEquipe?  @relation("Hierarquia", fields: [chefeId], references: [id], onDelete: SetNull)
  subordinados MembroEquipe[] @relation("Hierarquia")

  @@unique([organizacaoId, userId])
  @@index([organizacaoId])
  @@index([userId])
  @@index([chefeId])
}

// ============================================================
// COMERCIAL — Módulo pago/ligável (Agenda Comercial de ações)
// Quadro multi-unidade de ações de captação do setor comercial.
// Não é agenda individual; é o setor. Aditivo, isolado do core.
// ============================================================

enum StatusAcao {
  EM_PLANEJAMENTO
  FINALIZADO
  ADIADO
  CANCELADO
}

model Unidade {
  id            String   @id @default(cuid())
  organizacaoId String
  nome          String // cidade / unidade
  coordenadorId String? // userId do coordenador (vê/edita só esta unidade)
  ativa         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizacao Organizacao     @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  coordenador User?           @relation("UnidadeCoord", fields: [coordenadorId], references: [id], onDelete: SetNull)
  acoes       AcaoComercial[]

  @@index([organizacaoId])
  @@index([coordenadorId])
}

// Tipos de ação editáveis pelo diretor (liberdade pra criar tipos novos).
model TipoAcaoComercial {
  id            String   @id @default(cuid())
  organizacaoId String
  nome          String
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  @@unique([organizacaoId, nome])
  @@index([organizacaoId])
}

model AcaoComercial {
  id        String @id @default(cuid())
  unidadeId String

  // Planejamento (5W2H)
  tipo            String // nome do tipo (denormalizado da lista do diretor)
  objetivo        String // captação de lead, relacionamento, etc
  local           String // onde
  responsaveis    String // quem (texto livre: "Mariana, Regina")
  dataInicio      DateTime
  dataFim         DateTime
  detalhe         String?  @db.Text // como — planejamento completo (materiais, pessoas...)
  valorSolicitado Float? // quanto (verba pedida)

  // Execução (registrar resultado)
  status       StatusAcao @default(EM_PLANEJAMENTO)
  resultado    String? // Lead, Relacionamento...
  resultadoQtd Int? // quantitativo (ex: 38 leads)
  valorGasto   Float? // verba realmente gasta
  comentarios  String?    @db.Text

  criadoPorId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unidade Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@index([unidadeId])
  @@index([status])
}

// ============================================================
// BILLING — Gestão do produto (planos, assinatura, cobrança, parceiros)
// Referência de design: docs/Analise TriboCRM .../MODULO_PAGAMENTO_BLUEPRINT.md
// Princípio: o estado da assinatura mora na conta (Assinatura); cada cobrança
// é uma linha em Cobranca. UMA assinatura por conta = UMA cobrança por ciclo,
// cobrindo todos os assentos (empresa paga pelo time inteiro).
// Lançamento = cobrança MANUAL; gateway (Efí/PIX) entra na Fase 5 (campos já
// previstos como opcionais pra não exigir nova migration depois).
// ============================================================

enum StatusAssinatura {
  TRIAL     // em teste grátis (14 dias)
  ATIVA     // pagando em dia
  ATRASADA  // venceu e não pagou (PAYMENT_OVERDUE)
  SUSPENSA  // bloqueada por falta de pagamento
  CANCELADA // encerrada
}

enum CicloPlano {
  MENSAL
  ANUAL
}

enum MetodoPagamento {
  PIX
  BOLETO
  CARTAO
  MANUAL // baixa manual feita pelo super admin (lançamento)
}

enum StatusCobranca {
  PENDENTE
  PAGA
  ATRASADA
  CANCELADA
}

enum TipoDesconto {
  PERCENTUAL
  FIXO
}

// De onde a assinatura nasceu (pra distinguir quem "entrou direto" e contatar).
enum OrigemAssinatura {
  AUTO     // entrou direto (Google/link mágico) e ganhou trial automático
  CADASTRO // fez o cadastro e escolheu um plano conscientemente
  ADMIN    // criada pelo super admin
  TRIBO    // veio de um lead do formulário (webhook TriboCRM)
}

enum DuracaoCupom {
  PRIMEIRO   // só na 1ª cobrança
  RECORRENTE // em todo ciclo (por N meses)
}

enum StatusComissao {
  PENDENTE   // criada, dentro da carência
  DISPONIVEL // passou a carência, pode pagar
  PAGA       // payout feito (manual)
  ESTORNADA  // revertida (reembolso/chargeback)
}

// Catálogo de planos. Limites e features são COLUNAS — trocar o plano = trocar
// os números, sem mexer em código espalhado.
model Plano {
  id     String @id @default(cuid())
  slug   String @unique // "essencial" | "pro" | "enterprise"
  nome   String

  // Preço. Conta = precoMensal/Anual (base) + assentos extras × precoPorAssento.
  // Essencial: precoPorAssento = 0, assentosIncluidos = 1 (preço fixo).
  // Pro/Enterprise: precoPorAssento > 0 (cobrança por acesso).
  precoMensal      Float @default(0)
  precoAnual       Float @default(0)
  precoPorAssento  Float @default(0)
  assentosIncluidos Int  @default(1)

  // Permissões/limites destravados por este plano.
  moduloTimeAtivo      Boolean @default(false) // módulo de Time (Organizacao)
  moduloComercialAtivo Boolean @default(false) // Agenda Comercial
  geracoesIaMes        Int     @default(6)     // cota de IA/mês (ver cota-ia.ts)
  maxAssentos          Int?    // teto de assentos (null = ilimitado)

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assinaturas Assinatura[]

  @@index([ativo])
}

// A assinatura da conta. Dona = um User (quem paga). Se for plano de time,
// aponta também pra Organizacao. Os assentos vivem aqui, não no plano.
model Assinatura {
  id          String @id @default(cuid())
  ownerUserId String @unique // quem paga (dono da conta)
  organizacaoId String? @unique // preenchido quando é plano de time

  planoId String
  ciclo   CicloPlano       @default(MENSAL)
  status  StatusAssinatura @default(TRIAL)
  assentos Int             @default(1) // nº de acessos contratados

  trialTerminaEm  DateTime?
  planoIniciadoEm DateTime?
  planoExpiraEm   DateTime?
  metodoPreferido MetodoPagamento @default(MANUAL)

  // Onboarding: "entrou direto" (AUTO) ainda não escolheu plano → mostra o aviso.
  origem             OrigemAssinatura @default(AUTO)
  planoConfirmado    Boolean          @default(false) // já escolheu plano? (esconde o aviso)
  aguardandoAtivacao Boolean          @default(false) // escolheu plano pago e espera você ativar

  // Desconto recorrente concedido pelo super admin.
  descontoTipo   TipoDesconto?
  descontoValor  Float?
  descontoDe     DateTime?
  descontoAte    DateTime?
  descontoCiclos Int?
  descontoMotivo String?

  // Cartão recorrente (Efí) — Fase 5. Opcional desde já.
  efiSubscriptionId     String?
  efiSubscriptionStatus String?
  cartaoFinal           String?
  cartaoBandeira        String?
  proximaCobrancaEm     DateTime?

  // Máquina de estados de billing (idempotência dos e-mails) — ver job diário.
  ultimoEstadoBilling   String?
  ultimoEstadoBillingEm DateTime?

  // Indicação por parceiro.
  indicadoPorParceiroId String?
  indicadoEm            DateTime?

  notasInternas String? @db.Text // anotações de suporte/financeiro

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User         @relation("AssinaturaDono", fields: [ownerUserId], references: [id], onDelete: Cascade)
  organizacao Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: SetNull)
  plano       Plano        @relation(fields: [planoId], references: [id])
  parceiro    Parceiro?    @relation(fields: [indicadoPorParceiroId], references: [id], onDelete: SetNull)
  cobrancas   Cobranca[]
  comissoes   ComissaoParceiro[]
  trocasParceiro TrocaParceiro[]

  @@index([planoId])
  @@index([status])
  @@index([indicadoPorParceiroId])
}

// Cada cobrança individual da conta. mesRef alimenta os relatórios (MRR/ARR).
model Cobranca {
  id           String          @id @default(cuid())
  assinaturaId String
  valor        Float
  descontoValor Float          @default(0)
  vencimento   DateTime
  pagaEm       DateTime?
  metodo       MetodoPagamento @default(MANUAL)
  status       StatusCobranca  @default(PENDENTE)
  mesRef       String          // "YYYY-MM" — base dos relatórios

  // Gateway (Efí) — Fase 5.
  efiCobrancaId String?
  boletoUrl     String?
  pixCopiaECola String? @db.Text

  nota String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assinatura Assinatura        @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)
  comissao   ComissaoParceiro?

  @@index([assinaturaId])
  @@index([status])
  @@index([mesRef])
}

// Cupons de desconto. Soft-delete via ativo=false.
model Cupom {
  id             String       @id @default(cuid())
  code           String       @unique
  descontoTipo   TipoDesconto
  descontoValor  Float
  planosAplicaveis String[]   // slugs; vazio = todos
  maxUsos        Int?
  maxUsosPorUser Int?
  usados         Int          @default(0)
  validoDe       DateTime?
  validoAte      DateTime?
  duracaoTipo    DuracaoCupom @default(PRIMEIRO)
  duracaoMeses   Int?
  ativo          Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ativo])
}

// ============================================================
// PARCEIROS — programa de indicação (afiliados)
// ============================================================

// O afiliado/agência que indica clientes. code = "PRT" + 8 hex.
model Parceiro {
  id     String  @id @default(cuid())
  code   String  @unique
  userId String? @unique // conta na Bússola, se o parceiro tiver uma
  nome   String
  email  String?

  // Faixas progressivas de comissão (JSON): ex. [{ ateClientes: 5, rate: 15 }, ...].
  comissaoTiers Json?
  comissaoRate  Float @default(0) // legado / fallback quando não há tiers

  // Dados bancários para payout manual (PIX/TED).
  pixChave     String?
  banco        String?
  agencia      String?
  conta        String?
  tipoConta    String?

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  indicacoes Assinatura[]
  comissoes  ComissaoParceiro[]
  trocas     TrocaParceiro[]    @relation("ParceiroNovo")

  @@index([ativo])
}

// Uma linha por cobrança PAGA de cliente indicado. cobrancaId único = "uma
// comissão por cobrança" (idempotência mesmo com webhook duplicado).
model ComissaoParceiro {
  id           String         @id @default(cuid())
  parceiroId   String
  cobrancaId   String         @unique
  assinaturaId String
  valor        Float          // valor da cobrança
  rate         Float          // % congelado no momento da criação
  comissao     Float          // valor × rate / 100
  status       StatusComissao @default(PENDENTE)
  disponivelEm DateTime       // pagaEm + 30 dias (carência)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parceiro   Parceiro   @relation(fields: [parceiroId], references: [id], onDelete: Cascade)
  cobranca   Cobranca   @relation(fields: [cobrancaId], references: [id], onDelete: Cascade)
  assinatura Assinatura @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)

  @@index([parceiroId, status])
  @@index([status, disponivelEm])
  @@index([assinaturaId])
}

// Auditoria de troca de parceiro de uma conta (atribuição last-touch + histórico).
model TrocaParceiro {
  id              String   @id @default(cuid())
  assinaturaId    String
  parceiroAntigoId String?
  parceiroNovoId  String?
  alteradoPor     String?  // userId de quem mudou
  fonte           String   // "signup_cookie" | "gestor_ui" | "super_admin"
  createdAt       DateTime @default(now())

  assinatura    Assinatura @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)
  parceiroNovo  Parceiro?  @relation("ParceiroNovo", fields: [parceiroNovoId], references: [id], onDelete: SetNull)

  @@index([assinaturaId])
}
